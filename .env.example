# .env.example - Firebase Google Authentication Configuration
# Copy these values into your Vercel Dashboard (Settings -> Environment Variables)
# or into a local .env.local file.

# 1. Firebase Web App Credentials (from Firebase Console -> Project Settings -> General -> Your apps -> Web)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# 2. Athlete Security Allowlist (Comma-separated list of approved Google emails)
# Only users signed into Google with these email addresses will be allowed access.
# All other outsiders will be locked out immediately upon signing in.
VITE_ALLOWED_EMAILS=your.email@gmail.com,lagoo.training@gmail.com
